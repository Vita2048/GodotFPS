[layer_names]

3d_render/layer_1="world"
3d_render/layer_2="viewmodel"
3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="projectile"

[physics]

3d/default_gravity=18.0

[rendering]

lights_and_shadows/directional_shadow/size=2048
scaling_3d/scale=0.65
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.04, 1)
lights_and_shadows/positional_shadow/atlas_size=1024
